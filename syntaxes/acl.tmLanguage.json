{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AoTTG 2 Custom Logic",
  "scopeName": "source.acl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#class-definitions" },
    { "include": "#function-definitions" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#storage-types" },
    { "include": "#constructors" },
    { "include": "#member-access" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.acl",
          "patterns": [{ "include": "#annotations" }]
        },
        {
          "begin": "#",
          "end": "$",
          "name": "comment.line.hash.acl",
          "patterns": [{ "include": "#annotations" }]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.import.acl",
          "begin": "\\s*(@import)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.acl" }
          },
          "end": "$",
          "patterns": [
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "entity.name.namespace.acl" }
          ]
        },
        {
          "name": "meta.annotation.param.acl",
          "match": "\\s*(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+\\b(int|float|string|bool|any)\\b(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "variable.parameter.acl" },
            "3": { "name": "support.type.builtin.acl" },
            "4": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.param.acl",
          "match": "\\s*(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+\\b(function|coroutine)\\b(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "variable.parameter.acl" },
            "3": { "name": "storage.type.function.acl" },
            "4": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.param.acl",
          "match": "\\s*(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+((?:Game|Network|Map|UI|Time|Convert|String|Input|Math|Random|Cutscene|Camera|RoomData|PersistentData|Json|Physics|Component|Object|Character|Human|Titan|Shifter|MapObject|Transform|Player|NetworkView|Color|Vector3|Quaternion|LineCastHitResult)(?:\\s*<[^<>]*>)?)\\s*(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "variable.parameter.acl" },
            "3": { "name": "support.type.acl" },
            "4": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.param.acl",
          "match": "\\s*(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+((?:List|Dict|Set)\\s*<[^<>]*>)\\s*(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "variable.parameter.acl" },
            "3": { "name": "entity.name.type.class.acl" },
            "4": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.param.acl",
          "match": "\\s*(@param)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^<>]*>)?)\\s*(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "variable.parameter.acl" },
            "3": { "name": "entity.name.type.class.acl" },
            "4": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.typeish.acl",
          "match": "\\s*(@type|@return|@var)\\s+\\b(int|float|string|bool|any)\\b(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "support.type.builtin.acl" },
            "3": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.typeish.acl",
          "match": "\\s*(@type|@return|@var)\\s+\\b(function|coroutine)\\b(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "storage.type.function.acl" },
            "3": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.typeish.acl",
          "match": "\\s*(@type|@return|@var)\\s+((?:Game|Network|Map|UI|Time|Convert|String|Input|Math|Random|Cutscene|Camera|RoomData|PersistentData|Json|Physics|Component|Object|Character|Human|Titan|Shifter|MapObject|Transform|Player|NetworkView|Color|Vector3|Quaternion|LineCastHitResult)(?:\\s*<[^<>]*>)?)\\s*(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "support.type.acl" },
            "3": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.typeish.acl",
          "match": "\\s*(@type|@return|@var)\\s+((?:List|Dict|Set)\\s*<[^<>]*>)\\s*(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "entity.name.type.class.acl" },
            "3": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.typeish.acl",
          "match": "\\s*(@type|@return|@var)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*<[^<>]*>)?)\\s*(?:\\s+(.*?))?(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "entity.name.type.class.acl" },
            "3": { "name": "comment.line.description.acl" }
          }
        },
        {
          "name": "meta.annotation.unknown.acl",
          "match": "\\s*(@\\w+)\\b(.*?)(?=\\s*\\*/|$)",
          "captures": {
            "1": { "name": "storage.type.annotation.acl" },
            "2": { "name": "comment.line.description.acl" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.acl",
          "match": "\\b(if|else|elif|while|for|break|continue|return|in|wait)\\b"
        },
        {
          "name": "variable.language.self.acl",
          "match": "\\bself\\b"
        },
        {
          "name": "storage.type.function.acl",
          "match": "\\b(function|coroutine)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.acl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.acl",
          "match": "\\bnull\\b"
        }
      ]
    },
    "class-definitions": {
      "patterns": [
        {
          "match": "\\b(class|component|extension|cutscene)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.acl" },
            "2": { "name": "entity.name.type.class.acl" }
          }
        }
      ]
    },
    "function-definitions": {
      "begin": "\\b(function|coroutine)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "storage.type.function.acl" },
        "2": { "name": "entity.name.function.definition.acl" },
        "3": { "name": "punctuation.definition.parameters.begin.acl" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.acl" }
      },
      "patterns": [
        {
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
          "name": "variable.parameter.acl"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameter.acl"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.acl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.acl"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.acl",
          "match": "\\b\\d+\\.\\d+\\b|\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.acl",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "storage-types": {
      "patterns": [
        {
          "name": "support.type.builtin.acl",
          "match": "\\b(int|float|string|bool|any)\\b"
        },
        {
          "name": "support.type.acl",
          "match": "\\b(Game|Network|Map|UI|Time|Convert|String|Input|Math|Random|Cutscene|Camera|RoomData|PersistentData|Json|Physics|Component|Object|Character|Human|Titan|Shifter|MapObject|Transform|Player|NetworkView|Color|Vector3|Quaternion|LineCastHitResult)\\b"
        },
        { "include": "#generics" }
      ]
    },
    "generics": {
      "begin": "\\b(List|Dict|Set)\\s*(<)",
      "beginCaptures": {
        "1": { "name": "support.type.generic.acl" },
        "2": { "name": "punctuation.definition.generic.begin.acl" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.generic.end.acl" }
      },
      "patterns": [
        { "include": "#storage-types" },
        { "include": "#constructors" },
        { "match": ",", "name": "punctuation.separator.acl" }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "meta.constructor-call.acl",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.constructor.acl" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "name": "meta.method-call.acl",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.acl" },
            "2": { "name": "entity.name.function.member.acl" }
          }
        },
        {
          "name": "meta.property-access.acl",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.acl" },
            "2": { "name": "variable.other.property.acl" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.acl",
          "match": "==|!=|<=|>=|\\+=|\\-=|\\*=|\\/=|%=|&&|\\|\\||[+\\-*/%<>=!]"
        },
        {
          "name": "punctuation.delimiter.acl",
          "match": ",|;"
        },
        {
          "name": "punctuation.bracket.acl",
          "match": "\\(|\\)|\\{|\\}"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.private.acl",
          "match": "\\b_[A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.acl",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
