{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "AoTTG 2 Custom Logic",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#class-definitions"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#types"
        },
        {
            "include": "#generic-types"
        },
        {
            "include": "#functions"
        },
		{
			"include": "#function-definitions"
		},
		{
			"include": "#method-calls"
		},
		{
			"include": "#method-result-member-access"
		},
		{
			"include": "#class-member-access"
		},
        {
            "include": "#variables"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.annotation.acl",
                    "match": "#\\s*(@\\w+).*",
                    "captures": {
                        "0": {
                            "name": "comment.line.hash.acl"
                        },
                        "1": {
                            "name": "storage.type.annotation.acl"
                        }
                    }
                },
                {
                    "name": "comment.line.hash.acl",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.acl",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.acl",
					"match": "\\b(if|else|elif|while|for|break|continue|return|coroutine|in|function|wait)\\b"
                },
                {
                    "name": "constant.language.boolean.acl",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.null.acl",
                    "match": "\\bnull\\b"
                },
                {
                    "name": "variable.language.self.acl",
                    "match": "\\bself\\b"
                }
            ]
        },
        "class-definitions": {
            "patterns": [
                {
                    "name": "meta.class.definition.acl",
                    "match": "\\b(class|component|extension|cutscene)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.acl"
                        },
                        "2": {
                            "name": "entity.name.type.class.acl"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.acl",
                    "match": "\\+|\\-|\\*|\\/|%|==|!=|<=|>=|<|>|&&|\\|\\||!|=|\\+=|\\-=|\\*=|\\/=|%="
                },
                {
                    "name": "punctuation.delimiter.acl",
                    "match": ",|:|;|\\?"
                },
                {
                    "name": "punctuation.bracket.acl",
                    "match": "\\[|\\]|\\(|\\)|\\{|\\}"
                },
                {
                    "name": "punctuation.accessor.acl",
                    "match": "\\."
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.acl",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.acl",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.acl",
            "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.acl",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\s*(?=\\()"
                }
            ]
        },
        "function-definitions": {
            "patterns": [
                {
                    "name": "entity.name.function.definition.acl",
                    "match": "\\bfunction\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.acl"
                        }
                    }
                }
            ]
        },
        "method-calls": {
            "patterns": [
                {
                    "name": "meta.method-call.acl",
                    "match": "\\b([A-Z][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.class.acl"
                        },
                        "2": {
                            "name": "entity.name.function.acl"
                        }
                    }
                },
                {
                    "name": "meta.method-call.acl",
                    "match": "\\b([a-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "variable.other.object.acl"
                        },
                        "2": {
                            "name": "entity.name.function.acl"
                        }
                    }
                }
            ]
        },
        "class-member-access": {
            "patterns": [
                {
                    "name": "meta.class-member-access.acl",
                    "match": "\\b([A-Z][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.class.acl"
                        },
                        "2": {
                            "name": "variable.other.member.acl"
                        }
                    }
                }
            ]
        },
        "method-result-member-access": {
            "patterns": [
                {
                    "name": "meta.method-result-member-access.acl",
                    "match": "\\)\\.([A-Z][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "variable.other.object.acl"
                        },
                        "2": {
                            "name": "entity.name.function.acl"
                        }
                    }
                },
                {
                    "name": "meta.method-result-member-access.acl",
                    "match": "\\)\\.([A-Z][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "variable.other.object.acl"
                        },
                        "2": {
                            "name": "variable.other.member.acl"
                        }
                    }
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.private.acl",
                    "match": "\\b_[A-Za-z][A-Za-z0-9_]*\\b"
                },
                {
                    "name": "variable.other.acl",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.acl",
                    "match": "\\b(Game|Network|Map|UI|Time|Convert|String|Input|Math|Random|Cutscene|Camera|RoomData|PersistentData|Json|Physics|Component|Object|Character|Human|Titan|Shifter|MapObject|Transform|Player|NetworkView|Color|Vector3|Quaternion|Dict|List|Range|LineCastHitResult|int|float|string|bool|void|any)\\b"
                }
            ]
        },
        "generic-types": {
            "patterns": [
                {
                    "name": "meta.generic-type.acl",
                    "begin": "<",
                    "end": ">",
                    "patterns": [
                        {
                            "include": "#types"
                        },
                        {
                            "name": "entity.name.type.class.acl",
                            "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                        },
                        {
                            "include": "#generic-types"
                        }
                    ]
                }
            ]
        }
    },
    "scopeName": "source.acl"
}
